# Gemini API key — get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=xxxxxxxx

# Klaviyo private API key — Klaviyo account > Settings > API Keys
# Needs scopes: campaigns:write, flows:write (or flows:read for v1 if just drafting campaigns)
KLAVIYO_API_KEY=pk_xxxxxxxx

# App stage — controls whether the server uses its own KLAVIYO_API_KEY (development)
# or requires each visitor to provide their own key (production).
APP_STAGE=development

PORT=3001
